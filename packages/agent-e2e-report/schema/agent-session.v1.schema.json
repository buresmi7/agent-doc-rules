{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Session",
  "description": "A portable agent conversation with tool activity, project changes, expectations, and annotations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "session",
    "turns",
    "project",
    "evaluation",
    "annotations"
  ],
  "properties": {
    "format": {
      "const": "agent-session"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "source",
        "metadata"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "source": {
          "type": "object"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "turns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/turn"
      }
    },
    "project": {
      "type": "object",
      "required": [
        "finalChanges"
      ],
      "properties": {
        "filesHrefBase": {
          "type": "string"
        },
        "finalChanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectChange"
          }
        }
      }
    },
    "evaluation": {
      "type": [
        "object",
        "null"
      ]
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/annotation"
      }
    }
  },
  "$defs": {
    "turn": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "status",
        "items",
        "expectations",
        "projectChanges"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "expectations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expectation"
          }
        },
        "projectChanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectChange"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "source",
        "status",
        "reason",
        "targetItemId"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not-evaluated"
          ]
        },
        "reason": {
          "type": "string"
        },
        "targetItemId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "projectChange": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "path",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "patch": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "type",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "Annotation"
        },
        "motivation": {
          "type": "string"
        },
        "body": {},
        "target": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "source"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "selector": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/selector"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/selector"
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        }
      }
    }
  }
}
