{
  "name": "@buresmi7/agent-doc-rules-skill",
  "version": "1.0.0",
  "private": false,
  "description": "Agent Skill for concise AGENTS.md, README, and repository documentation rules",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/buresmi7/agent-doc-rules/tree/master/packages/agent-doc-rules-skill#readme",
  "bugs": {
    "url": "https://github.com/buresmi7/agent-doc-rules/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buresmi7/agent-doc-rules.git",
    "directory": "packages/agent-doc-rules-skill"
  },
  "bin": {
    "agent-doc-rules-skill": "bin/install.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e": "cd ../.. && corepack pnpm --recursive --workspace-concurrency=2 --filter './packages/agent-doc-rules-skill/e2e/*/project' --fail-if-no-match run test:agent"
  },
  "files": [
    "README.md",
    "bin",
    "docs",
    "skills"
  ],
  "devDependencies": {
    "@buresmi7/agent-e2e-report": "workspace:*",
    "@buresmi7/agent-e2e-runner": "workspace:*",
    "docmd-skills": "1.1.0",
    "skill-meta-skill": "0.1.0"
  },
  "agentDocRules": {
    "localSkills": [
      "agent-doc-rules",
      "docs-duplicate-review"
    ],
    "projectSkills": [
      {
        "name": "docmd-writer",
        "source": "docmd-skills"
      },
      {
        "name": "meta-skill",
        "source": "skill-meta-skill"
      }
    ]
  }
}
