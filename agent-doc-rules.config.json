{
  "docs": {
    "exclude": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "coverage/**",
      ".tmp/**",
      ".agent-e2e-output/**",
      "repos/**",
      "worktrees/**",
      ".agents/skills/**"
    ],
    "links": {
      "skip": [
        "^https://example\\.invalid(?:/|$)"
      ]
    },
    "wording": {
      "writeGood": {
        "passive": false,
        "illusion": false,
        "weasel": false,
        "adverb": false,
        "tooWordy": false,
        "eprime": false,
        "fail": false
      }
    },
    "security": {
      "exclude": [
        "node_modules/**",
        ".git/**",
        "dist/**",
        "coverage/**",
        ".tmp/**",
        ".agent-e2e-output/**",
        "repos/**",
        "worktrees/**",
        ".agents/skills/**",
        "packages/docs-validator/e2e/docs-security-command-fail/project/README.md",
        "packages/docs-validator/e2e/docs-security-command-pass/project/README.md"
      ]
    },
    "duplicateCandidates": {
      "exclude": [
        "node_modules/**",
        ".git/**",
        "dist/**",
        "coverage/**",
        ".tmp/**",
        ".agent-e2e-output/**",
        "repos/**",
        "worktrees/**",
        ".agents/skills/**",
        "docs/retired/docs-duplicates-changelog.md",
        "packages/**/e2e/**/project/**"
      ],
      "includeReferences": false,
      "includeSameFile": false,
      "minSimilarity": 0.72,
      "minWords": 6,
      "minChars": 40,
      "maxCandidates": 25,
      "ignorePairs": []
    }
  },
  "governance": {
    "exceptions": [
      {
        "setting": "docs.exclude",
        "value": ".agents/skills/**",
        "reason": "Generated project-skill copies are validated at their canonical package sources and by install-layout tests.",
        "decision": "docs/decisions/documentation-validation-exceptions.md"
      },
      {
        "setting": "docs.links.skip",
        "value": "^https://example\\.invalid(?:/|$)",
        "reason": "Reserved example URLs in documentation and fixtures are intentionally unreachable.",
        "decision": "docs/decisions/documentation-validation-exceptions.md"
      },
      {
        "setting": "docs.security.exclude",
        "value": "packages/docs-validator/e2e/docs-security-command-fail/project/README.md",
        "reason": "The isolated failure fixture must contain unsafe instructions for the security command E2E test.",
        "decision": "docs/decisions/documentation-validation-exceptions.md"
      },
      {
        "setting": "docs.security.exclude",
        "value": "packages/docs-validator/e2e/docs-security-command-pass/project/README.md",
        "reason": "The isolated pass fixture contains explicitly allowed remote-image and tracking examples.",
        "decision": "docs/decisions/documentation-validation-exceptions.md"
      },
      {
        "setting": "docs.duplicateCandidates.exclude",
        "value": "docs/retired/docs-duplicates-changelog.md",
        "reason": "The retired package changelog is historical output rather than current canonical documentation.",
        "decision": "docs/decisions/documentation-validation-exceptions.md"
      },
      {
        "setting": "docs.duplicateCandidates.exclude",
        "value": "packages/**/e2e/**/project/**",
        "reason": "Prepared E2E projects are isolated fixture input rather than repository documentation.",
        "decision": "docs/decisions/documentation-validation-exceptions.md"
      }
    ]
  }
}
